{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "customConditions": []
  },
  "include": ["scripts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"],
  "exclude": ["src/pages", "src/content.config.ts", "src/generated"]
}
