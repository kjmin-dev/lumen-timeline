{
  "name": "lumen-timeline",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/timeline",
    "packages/media",
    "packages/sync",
    "packages/react",
    "packages/svelte",
    "packages/solid",
    "packages/vue",
    "apps/docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && tsrs -b",
    "build": "tsrs -b",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "fix": "oxlint --fix && oxfmt",
    "check": "npm run fmt:check && npm run lint && npm run build && npm test && npm run test:dist && npm run parity && npm run api:check && npm run docs:check",
    "test": "node --conditions=@lumen-timeline/source --test packages/core/test/*.test.ts packages/media/test/*.test.ts packages/timeline/test/*.test.ts packages/sync/test/*.test.ts packages/react/test/*.test.ts packages/svelte/test/*.test.ts packages/solid/test/*.test.ts packages/vue/test/*.test.ts experiments/sync/*.test.mjs",
    "test:dist": "node --test packages/core/test/*.test.ts packages/media/test/*.test.ts packages/timeline/test/*.test.ts packages/sync/test/*.test.ts packages/react/test/*.test.ts packages/svelte/test/*.test.ts packages/solid/test/*.test.ts packages/vue/test/*.test.ts experiments/sync/*.test.mjs",
    "parity": "node scripts/compiler-parity.mjs",
    "api:check": "node scripts/api-snapshot.mjs",
    "api:update": "node scripts/api-snapshot.mjs --update",
    "docs:check": "node scripts/docs-links.mjs",
    "docs:dev": "npm --workspace @lumen-timeline/docs run dev",
    "docs:build": "npm --workspace @lumen-timeline/docs run build",
    "docs:preview": "npm --workspace @lumen-timeline/docs run preview",
    "docs:typecheck": "npm --workspace @lumen-timeline/docs run typecheck",
    "docs:test": "npm --workspace @lumen-timeline/docs run test",
    "check:docs": "npm run docs:build && npm run docs:typecheck && npm run docs:test",
    "deploy:docs": "./tools/deploy/node_modules/.bin/wrangler deploy --cwd apps/docs",
    "verify:sync": "node experiments/sync/run.mjs",
    "bench:wasm": "node experiments/wasm/run.mjs",
    "bench:peaks": "node experiments/peaks/run.mjs",
    "bench:commit": "node experiments/commit/run.mjs",
    "bench:session": "node experiments/session/run.mjs",
    "bench:render": "node examples/bench/run.mjs",
    "wasm:build": "node scripts/wasm.mjs",
    "wasm:check": "node scripts/wasm.mjs --check",
    "verify:pcm": "node experiments/sync/run.mjs chromium --pcm",
    "example:vanilla": "node examples/vanilla/server.mjs",
    "verify:timeline": "node examples/vanilla/verify.mjs",
    "verify:audio": "node examples/vanilla/verify-audio.mjs",
    "verify:milestone": "node examples/vanilla/verify-milestone.mjs",
    "verify:takes": "node examples/vanilla/verify-takes.mjs",
    "verify:studio": "node examples/vanilla/verify-studio.mjs",
    "verify:lines": "node examples/vanilla/verify-lines.mjs",
    "verify:waveforms": "node examples/vanilla/verify-waveforms.mjs",
    "verify:peaks": "node examples/vanilla/verify-peaks.mjs",
    "verify:scale": "node examples/vanilla/verify-scale.mjs",
    "verify:renderers": "node examples/vanilla/verify-renderers.mjs",
    "verify:mounts": "node examples/vanilla/verify-mounts.mjs",
    "verify:reusability": "node examples/vanilla/verify-reusability.mjs",
    "verify:shared": "node examples/sync/verify.mjs",
    "build:consumers": "node examples/frameworks/build.mjs",
    "verify:wrappers": "node examples/frameworks/verify.mjs",
    "bench:wrappers": "node examples/frameworks/bench.mjs"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-vue": "6.0.11",
    "babel-preset-solid": "2.0.0-rc.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "2.0.3",
    "svelte": "5.59.1",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.1.0-beta",
    "vite": "8.3.8",
    "vite-plugin-solid": "3.0.0-next.27",
    "vue": "3.5.46"
  },
  "allowScripts": {
    "lefthook": false
  }
}
