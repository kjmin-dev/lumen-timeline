{
  "name": "lumen-timeline",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/timeline",
    "packages/media"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test packages/core/*.test.mjs packages/media/*.test.mjs packages/timeline/*.test.mjs experiments/sync/*.test.mjs",
    "verify:sync": "node experiments/sync/run.mjs",
    "bench:wasm": "node experiments/wasm/run.mjs",
    "verify:pcm": "node experiments/sync/run.mjs chromium --pcm",
    "example:vanilla": "node examples/vanilla/server.mjs",
    "verify:timeline": "node examples/vanilla/verify.mjs",
    "verify:audio": "node examples/vanilla/verify-audio.mjs"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "playwright": "1.64.1"
  },
  "allowScripts": {
    "lefthook": false
  }
}
