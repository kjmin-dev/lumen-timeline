{
  "name": "lumen-timeline",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/timeline",
    "packages/media"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && tsrs -b",
    "build": "tsrs -b",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "fix": "oxlint --fix && oxfmt",
    "check": "npm run fmt:check && npm run lint && npm run build && npm test && npm run test:dist && npm run parity",
    "test": "node --conditions=@lumen-timeline/source --test packages/core/test/*.test.ts packages/media/*.test.mjs packages/timeline/*.test.mjs experiments/sync/*.test.mjs",
    "test:dist": "node --test packages/core/test/*.test.ts packages/media/*.test.mjs packages/timeline/*.test.mjs experiments/sync/*.test.mjs",
    "parity": "node scripts/compiler-parity.mjs",
    "verify:sync": "node experiments/sync/run.mjs",
    "bench:wasm": "node experiments/wasm/run.mjs",
    "verify:pcm": "node experiments/sync/run.mjs chromium --pcm",
    "example:vanilla": "node examples/vanilla/server.mjs",
    "verify:timeline": "node examples/vanilla/verify.mjs",
    "verify:audio": "node examples/vanilla/verify-audio.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "playwright": "1.64.1",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.1.0-beta"
  },
  "allowScripts": {
    "lefthook": false
  }
}
