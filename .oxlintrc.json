{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["packages/*/*.mjs", "packages/*/src/**"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@lumen-timeline/media",
                "message": "The core stays headless and must not import browser packages."
              },
              {
                "name": "@lumen-timeline/timeline",
                "message": "The core stays headless and must not import browser packages."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "The core runs without Node built-ins."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "typescript/ban-ts-comment": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/only-throw-error": "error",
        "typescript/switch-exhaustiveness-check": "error"
      }
    },
    {
      "files": ["**/*.test.mjs", "**/*.test.ts", "**/test/**"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "no-restricted-imports": "off",
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "package": "node:test",
                "name": ["test", "it", "describe", "suite"]
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
